-D
-b 8192
-f 1

# identity & auth
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/pam.d/ -p wa -k pam
-w /etc/security/ -p wa -k pam
-w /etc/polkit-1/ -p wa -k polkit
-w /usr/share/polkit-1/rules.d/ -p wa -k polkit

# privilege escalation
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k setuid
-a always,exit -F arch=b64 -S setuid,setgid,setresuid,setresgid -k priv

# kernel modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-w /usr/lib/modprobe.d/ -p wa -k modules

# mounts, time, network config
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=-1 -k mount
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time
-w /etc/NetworkManager/ -p wa -k network
-w /etc/systemd/resolved.conf.d/ -p wa -k network
-w /etc/hosts -p wa -k network

# system config & policy
-w /etc/selinux/ -p wa -k selinux
-w /etc/audit/ -p wa -k audit
-w /etc/crypto-policies/ -p wa -k crypto
-w /etc/ssh/sshd_config.d/ -p wa -k sshd

# make rules immutable until reboot
-e 2
