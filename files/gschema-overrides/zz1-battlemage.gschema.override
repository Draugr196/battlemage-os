[org.gnome.shell]
enabled-extensions=['appindicatorsupport@rgcjonas.gmail.com', 'dash-to-panel@jderose9.github.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'caffeine@patapon.info', 'ding@rastersoft.com', 'blur-my-shell@aunetx']
favorite-apps=['librewolf.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop', 'io.github.kolunmi.Bazaar.desktop', 'com.ranfdev.DistroShelf.desktop']

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'
theme='Battlemage'

[org.gnome.desktop.interface]
gtk-theme='Battlemage'
monospace-font-name='Hack Nerd Font Mono 10'
document-font-name='Hack Nerd Font Mono 11'
font-name='Hack Nerd Font Mono 11'
icon-theme='Papirus'
color-scheme='prefer-dark'

[org.gnome.shell.extensions.user-theme]
name='Battlemage'

[org.gnome.shell.extensions.blur-my-shell.applications]
blur=true
dynamic-opacity=false
enable-all=true
opacity=238
rounded-corners=3
static-blur=false

[org.gnome.shell.extensions.blur-my-shell.popup]
preserve-shell-theme=true
rouned-corners=3

[org.gnome.login-screen]
logo=''

[org.gnome.desktop.background]
picture-uri='/usr/share/backgrounds/battlemage.png'
picture-uri-dark='/usr/share/backgrounds/battlemage.png'
