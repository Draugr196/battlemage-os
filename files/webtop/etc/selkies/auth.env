# Web desktop sign-in. Changes apply within a few seconds; no restart needed.

# Who may sign in (with their system password). Each person gets their own
# desktop. Comma-separated groups; wheel covers the admin account you make at
# install or first boot.
SELKIES_AUTH_GROUP=selkies-users,wheel
# Plus individual accounts outside those groups:
#SELKIES_AUTH_USERS=alice,bob

# Name shown on the sign-in page (default: this computer's host name)
#SELKIES_PORTAL_TITLE=My Desktop

# Sign people out after this many hours without using the desktop, and
# always after this many hours since they signed in.
#SELKIES_SESSION_IDLE_HOURS=12
#SELKIES_SESSION_MAX_HOURS=168
