[Unit]
Description=PAM login check and desktop launcher for Selkies (Caddy forward_auth)
Before=caddy.service
After=gdm.service

[Service]
ExecStart=/usr/libexec/selkies-pam-auth
Restart=on-failure
RuntimeDirectory=selkies-auth
RuntimeDirectoryMode=0755

NoNewPrivileges=yes
ProtectSystem=strict

ProtectHome=no
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no

ReadWritePaths=-/var/log

[Install]
WantedBy=multi-user.target
