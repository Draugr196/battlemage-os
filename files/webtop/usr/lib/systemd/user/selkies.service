[Unit]
Description=Selkies stream of this user's GNOME session
# Only for web desktop users (not GDM's own login-screen session)
ConditionGroup=selkies-users
PartOf=graphical-session.target
After=graphical-session.target xdg-desktop-portal.service pipewire.service wireplumber.service selkies-consent.service
Wants=xdg-desktop-portal.service pipewire.service

[Service]
# Image defaults, then your overrides (public IP, TURN, STUN, encoder...).
# Socket, WebRTC ports and login are per-user and set by the wrapper.
EnvironmentFile=/usr/share/selkies/defaults.env
EnvironmentFile=-/etc/selkies/local.env
ExecStart=/usr/libexec/selkies-user-session
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
