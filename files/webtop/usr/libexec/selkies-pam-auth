ICON = ('<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" '
        'stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">'
        '<rect x="3" y="4" width="18" height="12"/><path d="M8 20h8M12 16v4"/></svg>')

CSP = ("default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; "
       "connect-src 'self'; img-src 'self' data:; form-action 'self'; "
       "frame-ancestors 'none'; base-uri 'none'")


def page(title, body, script=""):
    t = html.escape(portal_title())
    doc = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex">
<title>{html.escape(title)} · {t}</title>
<style>{CSS}</style></head>
<body><main><div class="window">
<div class="headerbar">{ICON}<div><div class="title">{t}</div><div class="subtitle">Remote desktop</div></div></div>
<div class="content">
{body}
</div></div></main>{('<script>' + script + '</script>') if script else ''}</body></html>"""
    return doc.encode()


def login_page(next_url, username="", error=None, notice=None):
    msg = ""
    if error:
        msg = f'<div class="notice error" role="alert">{html.escape(error)}</div>'
    elif notice:
        msg = f'<div class="notice ok" role="status">{html.escape(notice)}</div>'
    body = f"""<h1>Sign in</h1>
<p class="lead">Use your account on this computer.</p>
{msg}
<form method="post" action="{PORTAL}/login" id="f" novalidate>
<input type="hidden" name="next" value="{html.escape(next_url)}">
<label for="u">Username</label>
<input id="u" name="username" value="{html.escape(username)}" autocomplete="username"
 autocapitalize="none" autocorrect="off" spellcheck="false" required {'' if username else 'autofocus'}>
<label for="p">Password</label>
<input id="p" name="password" type="password" autocomplete="current-password" required {'autofocus' if username else ''}>
<button type="submit" id="b">Sign in</button>
</form>
<p class="foot">Your desktop starts after you sign in.</p>"""
    script = """document.getElementById('f').addEventListener('submit',function(e){
var u=document.getElementById('u'),p=document.getElementById('p');
if(!u.value){e.preventDefault();u.focus();return}
if(!p.value){e.preventDefault();p.focus();return}
var b=document.getElementById('b');b.disabled=true;b.textContent='Signing in\\u2026';});"""
    return page("Sign in", body, script)


def starting_page(next_url):
    body = f"""<div class="progress" id="spin" role="progressbar" aria-label="Starting"></div>
<h1 id="h">Starting your desktop</h1>
<p class="lead" id="m">This usually takes a few seconds.</p>
<div class="notice error" id="err" role="alert" hidden></div>
<button type="button" id="retry" hidden>Try again</button>
<p class="foot"><a href="{PORTAL}/logout">Sign out</a></p>"""
    script = """(function(){
var next=%s,t0=Date.now(),busy=false;
var h=document.getElementById('h'),m=document.getElementById('m'),
    err=document.getElementById('err'),retry=document.getElementById('retry'),
    spin=document.getElementById('spin');
function poll(again){
  if(busy)return;busy=true;
  fetch('%s/status'+(again?'?retry=1':''),{credentials:'same-origin',cache:'no-store'})
  .then(function(r){if(r.status===401){location.replace('%s/login');throw 0}return r.json()})
  .then(function(s){
    busy=false;
    if(s.state==='ready'){location.replace(next);return}
    if(s.state==='failed'){spin.hidden=true;h.textContent='Couldn\\u2019t start your desktop';
      m.hidden=true;err.textContent=s.message;err.hidden=false;retry.hidden=false;return}
    if(Date.now()-t0>45000){m.textContent='This is taking longer than usual. Hang on\\u2026'}
    setTimeout(poll,1500);
  }).catch(function(e){busy=false;if(e!==0)setTimeout(poll,3000)});
}
retry.addEventListener('click',function(){retry.hidden=true;err.hidden=true;spin.hidden=false;
  h.textContent='Starting your desktop';m.hidden=false;m.textContent='Trying again\\u2026';t0=Date.now();poll(true)});
poll(false);
})();""" % (json.dumps(next_url), PORTAL, PORTAL)
    return page("Starting your desktop", body, script)


def safe_next(value):
    """Only same-site paths; never back into the portal itself."""
    v = (value or "").strip()
    if (not v.startswith("/") or v.startswith("//") or v.startswith("/\\")
            or v.startswith(PORTAL) or len(v) > 2000 or any(c in v for c in "\r\n\0")):
        return "/"
    return v


# --------------------------------------------------------------------------
# HTTP
# --------------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    server_version = "selkies-portal"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    def address_string(self):
        return self.client()

    def log_message(self, fmt, *args):
        pass  # only log what matters, below

    # -- request helpers -----------------------------------------------

    def client(self):
        fwd = self.headers.get("X-Forwarded-For", "")
        return fwd.split(",")[0].strip() or "unknown"

    def cookie(self):
        for part in self.headers.get("Cookie", "").split(";"):
            name, _, value = part.strip().partition("=")
            if name == COOKIE:
                return value
        return None

    def query(self):
        return urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)

    def same_origin(self):
        """POSTs (and sign-out) must come from this site's own pages."""
        site = self.headers.get("Sec-Fetch-Site")
        if site in ("same-origin", "none"):
            return True
        origin = self.headers.get("Origin")
        host = self.headers.get("Host", "")
        if origin:
            return origin == f"https://{host}"
        return site is None and self.command == "GET"

    def is_page_load(self):
        """A browser loading a page (so a redirect makes sense), as opposed
        to a websocket, fetch or asset request."""
        if self.headers.get("Upgrade"):
            return False
        if self.headers.get("X-Forwarded-Method", "GET") not in ("GET", "HEAD"):
            return False
        mode = self.headers.get("Sec-Fetch-Mode")
        if mode:
            return mode == "navigate"
        return "text/html" in self.headers.get("Accept", "")

    # -- responses ------------------------------------------------------

    def send(self, status, body=b"", ctype="text/html; charset=utf-8", headers=()):
        self.send_response(status)
        for k, v in headers:
            self.send_header(k, v)
        if body:
            self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        if ctype.startswith("text/html"):
            self.send_header("Content-Security-Policy", CSP)
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        if body and self.command != "HEAD":
            self.wfile.write(body)

    def redirect(self, location, status=302, headers=()):
        self.send(status, headers=[("Location", location), *headers])

    def set_cookie(self, token):
        return ("Set-Cookie", f"{COOKIE}={token}; Path=/; Secure; HttpOnly; "
                              f"SameSite=Strict; Max-Age={session_max_age()}")

    def clear_cookie(self):
        return ("Set-Cookie", f"{COOKIE}=; Path=/; Secure; HttpOnly; SameSite=Strict; Max-Age=0")

    # -- routing --------------------------------------------------------

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path == "/auth":
            return self.check()
        if path == f"{PORTAL}/login":
            q = self.query()
            nxt = safe_next(q.get("next", ["/"])[0])
            if session_user(self.cookie()):
                return self.redirect(nxt)
            notice = "You've been signed out." if "signed_out" in q else None
            return self.send(200, login_page(nxt, notice=notice))
        if path == f"{PORTAL}/starting":
            nxt = safe_next(self.query().get("next", ["/"])[0])
            if not session_user(self.cookie()):
                return self.redirect(f"{PORTAL}/login?next={urllib.parse.quote(nxt)}")
            return self.send(200, starting_page(nxt))
        if path == f"{PORTAL}/status":
            user = session_user(self.cookie())
            if not user:
                return self.send(401, b'{"state":"signed-out"}', "application/json")
            state, message = desktop_state(user, retry="retry" in self.query())
            return self.send(200, json.dumps({"state": state, "message": message}).encode(),
                             "application/json")
        if path == f"{PORTAL}/logout":
            if not self.same_origin():
                return self.send(403, b"Forbidden", "text/plain")
            return self.logout()
        return self.send(404, b"Not found", "text/plain")

    do_HEAD = do_GET

    def do_POST(self):
        # Always consume the body first: an unread body left on a kept-alive
        # connection would be misread as the next request.
        try:
            n = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            n = -1
        if n < 0 or n > MAX_FORM:
            self.close_connection = True
            return self.send(413, b"Too large", "text/plain", headers=[("Connection", "close")])
        self.body = self.rfile.read(n) if n else b""
        path = urllib.parse.urlsplit(self.path).path
        if path == f"{PORTAL}/login":
            return self.login()
        if path == f"{PORTAL}/logout":
            if not self.same_origin():
                return self.send(403, b"Forbidden", "text/plain")
            return self.logout()
        if path == "/auth":   # forward_auth may use the original method
            return self.check()
        return self.send(404, b"Not found", "text/plain")

    # -- handlers -------------------------------------------------------

    def check(self):
        """forward_auth: is this request from a signed-in user whose desktop is up?"""
        user = session_user(self.cookie())
        original = self.headers.get("X-Forwarded-Uri", "/")
        if not user:
            if self.is_page_load():
                return self.redirect(f"{PORTAL}/login?next={urllib.parse.quote(safe_next(original))}")
            return self.send(401, b"Not signed in", "text/plain")
        state, _ = desktop_state(user)
        if state == "ready":
            return self.send(200, headers=[("X-Remote-User", user)])
        if self.is_page_load():
            return self.redirect(f"{PORTAL}/starting?next={urllib.parse.quote(safe_next(original))}")
        return self.send(503, b"Desktop not ready", "text/plain", headers=[("Retry-After", "3")])

    def login(self):
        if not self.same_origin():
            return self.send(403, b"Forbidden", "text/plain")
        form = urllib.parse.parse_qs(self.body.decode("utf-8", "replace"),
                                     keep_blank_values=True)
        username = form.get("username", [""])[0].strip()
        password = form.get("password", [""])[0]
        nxt = safe_next(form.get("next", ["/"])[0])
        client = self.client()

        if locked_out(client):
            return self.send(429, login_page(nxt, username,
                             "Too many failed attempts. Wait a minute, then try again."))
        if not username or not password:
            return self.send(200, login_page(nxt, username, "Enter your username and password."))

        ok = False
        if USERNAME_RE.match(username) and "\0" not in password and len(password) <= 1024:
            ok, reason = pam_check(username, password)
        else:
            reason = "invalid username"
        if ok and not user_allowed(username):
            log(f"refused {username} from {client}: not allowed to use the web desktop")
            record_failure(client)
            time.sleep(FAIL_DELAY)
            return self.send(200, login_page(nxt, username,
                             "This account isn't allowed to use the remote desktop."))
        if not ok:
            log(f"failed sign-in for {username!r} from {client}: {reason}")
            record_failure(client)
            time.sleep(FAIL_DELAY)
            return self.send(200, login_page(nxt, username, "Incorrect username or password."))

        clear_failures(client)
        token = new_session(username)
        log(f"signed in {username} from {client}")
        desktop_state(username)                 # start it now, in the background
        return self.redirect(nxt, 303, [self.set_cookie(token)])

    def logout(self):
        token = self.cookie()
        user = session_user(token)
        end_session(token)
        if user:
            log(f"signed out {user} from {self.client()}")
        return self.redirect(f"{PORTAL}/login?signed_out=1", 303, [self.clear_cookie()])


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True

    def handle_error(self, request, client_address):
        exc = sys.exc_info()[1]
        if isinstance(exc, (BrokenPipeError, ConnectionResetError)):
            return  # the client went away; nothing to report
        log(f"error handling a request: {exc!r}")


def main():
    try:
        os.unlink(SOCKET)
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(SOCKET), exist_ok=True)
    old = os.umask(0o117)
    try:
        srv = Server(SOCKET, Handler)
    finally:
        os.umask(old)
    try:
        os.chown(SOCKET, 0, grp.getgrnam("caddy").gr_gid)
    except (KeyError, PermissionError):
        log("could not hand the socket to the 'caddy' group; left as is")
    os.chmod(SOCKET, 0o660)
    log(f"listening on {SOCKET} (PAM service '{PAM_SERVICE.decode()}')")
    srv.serve_forever()


if __name__ == "__main__":
    main()
