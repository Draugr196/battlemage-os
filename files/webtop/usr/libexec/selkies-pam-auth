#!/usr/bin/python3 -I
"""
selkies-pam-auth: web sign-in portal for Selkies desktops, checked against PAM.

Caddy sends every request here first (forward_auth to /auth) and proxies the
portal's own pages (/__selkies/*) straight here. Sign-in is a normal web form;
a successful sign-in sets a session cookie, so the password is sent once, not
with every request.

  /auth                     forward_auth check for everything else:
                              200 + X-Remote-User   signed in, desktop is up
                              302 -> sign-in page   page load, not signed in
                              302 -> starting page  page load, desktop starting
                              401 / 503             other requests (websockets,
                                                    fetches) in those cases
  /__selkies/login          GET: the sign-in form. POST: check it against PAM.
  /__selkies/starting       "Starting your desktop" page; moves on when ready
  /__selkies/status         JSON for that page: ready / starting / failed
  /__selkies/logout         end the web session (the desktop keeps running)

Each user gets their own desktop. Starting one means:
  selkies-proxy@<user>.socket          root-owned /run/selkies/<user>.sock that
                                       Caddy connects to; it hands connections
                                       to a proxy running *as that user*
  gnome-headless-session@<user>.service   GDM's headless GNOME session, whose
                                       selkies.service listens on
                                       /run/user/<uid>/selkies.sock

Listens only on a Unix socket that the caddy group can reach. Runs as root
because pam_unix can only check other users' passwords as root, and to start
the units above. Sessions live in memory: restarting this service signs
everyone out (their desktops keep running).

Config (optional), /etc/selkies/auth.env:
  SELKIES_AUTH_GROUP=selkies-users,wheel   members of these groups may sign in
                                           (default; comma-separated)
  SELKIES_AUTH_USERS=alice,bob             plus these users
  SELKIES_PORTAL_TITLE=My Desktop          name on the sign-in page
                                           (default: the host name)
  SELKIES_SESSION_IDLE_HOURS=12            sign out after this long unused
  SELKIES_SESSION_MAX_HOURS=168            and always after this long
"""

import grp
import hashlib
import html
import json
import os
import pwd
import re
import secrets
import socket
import socketserver
import subprocess
import sys
import threading
import time
import urllib.parse
from collections import defaultdict
from ctypes import (CDLL, CFUNCTYPE, POINTER, Structure, c_char_p, c_int,
                    c_size_t, c_void_p, cast, sizeof)
from ctypes.util import find_library
from http.server import BaseHTTPRequestHandler

SOCKET = os.environ.get("SELKIES_AUTH_SOCKET", "/run/selkies-auth/auth.sock")
PAM_SERVICE = os.environ.get("SELKIES_AUTH_PAM_SERVICE", "selkies").encode()
CONFIG = os.environ.get("SELKIES_AUTH_CONFIG", "/etc/selkies/auth.env")
FRONT_DIR = os.environ.get("SELKIES_AUTH_FRONT_DIR", "/run/selkies")    # per-user front sockets
RUNTIME_DIR = os.environ.get("SELKIES_AUTH_RUNTIME_DIR", "/run/user")   # users' Selkies sockets

PORTAL = "/__selkies"
COOKIE = "__Host-selkies-session"   # __Host-: Secure, Path=/, no Domain, enforced by browsers

FAIL_LIMIT = 5           # failed sign-ins per client before a lockout
FAIL_WINDOW = 300        # ...counted over this many seconds
LOCKOUT = 60             # seconds locked out
FAIL_DELAY = 1.5         # pause on every failure
MAX_FORM = 8192          # bytes accepted in a sign-in POST

DEFAULT_GROUP = "selkies-users,wheel"
START_TIMEOUT = int(os.environ.get("SELKIES_AUTH_START_WAIT", "120"))  # seconds for a desktop to come up
# Safe for unit instance names and socket paths; no leading dot or dash
USERNAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_.-]{0,31}$")


def log(msg):
    print(f"selkies-pam-auth: {msg}", file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# PAM through ctypes (no extra packages needed)
# --------------------------------------------------------------------------

PAM_PROMPT_ECHO_OFF = 1
PAM_PROMPT_ECHO_ON = 2
PAM_SUCCESS = 0


class PamHandle(Structure):
    _fields_ = [("handle", c_void_p)]


class PamMessage(Structure):
    _fields_ = [("msg_style", c_int), ("msg", c_char_p)]


class PamResponse(Structure):
    _fields_ = [("resp", c_void_p), ("resp_retcode", c_int)]


CONV_FUNC = CFUNCTYPE(c_int, c_int, POINTER(POINTER(PamMessage)),
                      POINTER(POINTER(PamResponse)), c_void_p)


class PamConv(Structure):
    _fields_ = [("conv", CONV_FUNC), ("appdata_ptr", c_void_p)]


_libpam = CDLL(find_library("pam"))
_libc = CDLL(find_library("c"))

_pam_start = _libpam.pam_start
_pam_start.restype = c_int
_pam_start.argtypes = [c_char_p, c_char_p, POINTER(PamConv), POINTER(PamHandle)]

_pam_authenticate = _libpam.pam_authenticate
_pam_authenticate.restype = c_int
_pam_authenticate.argtypes = [PamHandle, c_int]

_pam_acct_mgmt = _libpam.pam_acct_mgmt
_pam_acct_mgmt.restype = c_int
_pam_acct_mgmt.argtypes = [PamHandle, c_int]

_pam_end = _libpam.pam_end
_pam_end.restype = c_int
_pam_end.argtypes = [PamHandle, c_int]

_pam_strerror = _libpam.pam_strerror
_pam_strerror.restype = c_char_p
_pam_strerror.argtypes = [PamHandle, c_int]

# PAM frees the responses, so they must come from malloc
_calloc = _libc.calloc
_calloc.restype = c_void_p
_calloc.argtypes = [c_size_t, c_size_t]
_strdup = _libc.strdup
_strdup.restype = c_void_p
_strdup.argtypes = [c_char_p]


def pam_check(username: str, password: str) -> tuple[bool, str]:
    user_b = username.encode()
    pass_b = password.encode()

    @CONV_FUNC
    def conv(n_messages, messages, p_response, _appdata):
        addr = _calloc(n_messages, sizeof(PamResponse))
        if not addr:
            return 20  # PAM_BUF_ERR
        responses = cast(addr, POINTER(PamResponse))
        p_response[0] = responses
        for i in range(n_messages):
            style = messages[i].contents.msg_style
            if style == PAM_PROMPT_ECHO_OFF:
                responses[i].resp = _strdup(pass_b)
            elif style == PAM_PROMPT_ECHO_ON:
                responses[i].resp = _strdup(user_b)
            responses[i].resp_retcode = 0
        return PAM_SUCCESS

    handle = PamHandle()
    pconv = PamConv(conv, 0)
    rc = _pam_start(PAM_SERVICE, user_b, pconv, handle)
    if rc != PAM_SUCCESS:
        return False, f"pam_start failed ({rc})"
    try:
        rc = _pam_authenticate(handle, 0)
        if rc == PAM_SUCCESS:
            # Expired, disabled or locked accounts fail here
            rc = _pam_acct_mgmt(handle, 0)
        reason = (_pam_strerror(handle, rc) or b"").decode(errors="replace")
        return rc == PAM_SUCCESS, reason
    finally:
        _pam_end(handle, rc)


# --------------------------------------------------------------------------
# Who may use the session
# --------------------------------------------------------------------------

def read_config():
    cfg = {}
    try:
        with open(CONFIG) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return cfg


def user_allowed(username: str) -> bool:
    if not USERNAME_RE.match(username):
        return False
    cfg = read_config()  # re-read each time so edits apply without a restart
    users = {u.strip() for u in cfg.get("SELKIES_AUTH_USERS", "").split(",") if u.strip()}
    groups = [g.strip() for g in cfg.get("SELKIES_AUTH_GROUP", DEFAULT_GROUP).split(",") if g.strip()]
    if username in users:
        return True
    for group in groups:
        try:
            g = grp.getgrnam(group)
            if username in g.gr_mem:
                return True
            if pwd.getpwnam(username).pw_gid == g.gr_gid:
                return True
        except KeyError:
            continue
    return False



# Config is read on every request; cache it briefly
_read_config_uncached = read_config
_cfg_cache = {"t": 0.0, "v": {}}


def read_config():  # noqa: F811 (replaces the uncached version above)
    now = time.monotonic()
    if now - _cfg_cache["t"] > 5:
        _cfg_cache["v"] = _read_config_uncached()
        _cfg_cache["t"] = now
    return _cfg_cache["v"]


def cfg_hours(key, default):
    try:
        return max(0.05, float(read_config().get(key, default)))
    except ValueError:
        return default


def portal_title():
    return read_config().get("SELKIES_PORTAL_TITLE") or socket.gethostname()


# --------------------------------------------------------------------------
# Starting a user's desktop (in the background)
# --------------------------------------------------------------------------

_start_locks = defaultdict(threading.Lock)
_state_lock = threading.Lock()
_starts = {}   # username -> {"thread": Thread, "error": str | None}


def systemctl(*args):
    try:
        r = subprocess.run(["systemctl", *args], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"systemctl {' '.join(args)}: {e}")
        return False
    if r.returncode != 0:
        log(f"systemctl {' '.join(args)}: {(r.stderr or r.stdout).strip()}")
    return r.returncode == 0


def loginctl_value(*args):
    try:
        r = subprocess.run(["loginctl", *args, "--value"], capture_output=True,
                           text=True, timeout=10)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def has_local_graphical_session(uid):
    """A graphical session on a real seat. GDM won't also start a headless
    one for the same user, so we use whatever that session runs instead."""
    for sid in loginctl_value("show-user", str(uid), "-p", "Sessions").split():
        stype = loginctl_value("show-session", sid, "-p", "Type")
        seat = loginctl_value("show-session", sid, "-p", "Seat")
        state = loginctl_value("show-session", sid, "-p", "State")
        if stype in ("wayland", "x11") and seat and state != "closing":
            return True
    return False


def selkies_live(uid):
    path = os.path.join(RUNTIME_DIR, str(uid), "selkies.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        try:
            s.connect(path)
            return True
        except OSError:
            return False


def desktop_ready(username):
    try:
        uid = pwd.getpwnam(username).pw_uid
    except KeyError:
        return False
    return selkies_live(uid) and os.path.exists(os.path.join(FRONT_DIR, f"{username}.sock"))


def _start_desktop(username):
    """Background thread: bring the user's desktop up, or record why not."""
    error = None
    try:
        uid = pwd.getpwnam(username).pw_uid
        with _start_locks[username]:
            if not desktop_ready(username):
                systemctl("start", f"selkies-proxy@{username}.socket")
                if not selkies_live(uid):
                    if has_local_graphical_session(uid):
                        log(f"{username} has a local session; waiting for its Selkies")
                    else:
                        log(f"starting a headless desktop for {username}")
                        systemctl("start", "--no-block",
                                  f"gnome-headless-session@{username}.service")
                deadline = time.monotonic() + START_TIMEOUT
                while not desktop_ready(username):
                    if time.monotonic() > deadline:
                        error = ("Your desktop didn't start in time. "
                                 "Try again, or ask an administrator to check the logs.")
                        log(f"{username}'s desktop didn't come up within {START_TIMEOUT}s")
                        break
                    time.sleep(0.5)
                else:
                    log(f"{username}'s desktop is up")
    except Exception as e:  # never let a start failure kill the thread silently
        error = "Your desktop couldn't be started."
        log(f"could not start {username}'s desktop: {e}")
    with _state_lock:
        _starts[username]["error"] = error


def desktop_state(username, retry=False):
    """('ready'|'starting'|'failed', message). Starts the desktop if needed;
    never blocks."""
    if desktop_ready(username):
        return "ready", None
    with _state_lock:
        st = _starts.get(username)
        if st and st["thread"].is_alive():
            return "starting", None
        if st and st["error"] and not retry:
            return "failed", st["error"]
        t = threading.Thread(target=_start_desktop, args=(username,), daemon=True)
        _starts[username] = {"thread": t, "error": None}
        t.start()
    return "starting", None


# --------------------------------------------------------------------------
# Sessions and brute-force throttling
# --------------------------------------------------------------------------

_lock = threading.Lock()
_sessions = {}   # sha256(token) -> {"user", "created", "seen"}
_fails = {}      # client -> [timestamps]
_locked = {}     # client -> unlock time


def _key(token):
    return hashlib.sha256(token.encode()).hexdigest()


def new_session(username):
    token = secrets.token_urlsafe(32)
    now = time.time()
    with _lock:
        _sessions[_key(token)] = {"user": username, "created": now, "seen": now}
    return token


def session_user(token):
    """The signed-in user for this cookie value, or None."""
    if not token or len(token) > 100:
        return None
    idle = cfg_hours("SELKIES_SESSION_IDLE_HOURS", 12) * 3600
    maximum = cfg_hours("SELKIES_SESSION_MAX_HOURS", 168) * 3600
    now = time.time()
    with _lock:
        s = _sessions.get(_key(token))
        if not s:
            return None
        if now - s["seen"] > idle or now - s["created"] > maximum:
            del _sessions[_key(token)]
            return None
        s["seen"] = now
        user = s["user"]
    # Still a valid account that may sign in? (group changes apply at once)
    try:
        pwd.getpwnam(user)
    except KeyError:
        return None
    return user if user_allowed(user) else None


def end_session(token):
    if token:
        with _lock:
            _sessions.pop(_key(token), None)


def session_max_age():
    return int(cfg_hours("SELKIES_SESSION_MAX_HOURS", 168) * 3600)


def locked_out(client):
    with _lock:
        return _locked.get(client, 0) > time.monotonic()


def record_failure(client):
    now = time.monotonic()
    with _lock:
        recent = [t for t in _fails.get(client, []) if now - t < FAIL_WINDOW]
        recent.append(now)
        _fails[client] = recent
        if len(recent) >= FAIL_LIMIT:
            _locked[client] = now + LOCKOUT
            _fails[client] = []
            log(f"locking out {client} for {LOCKOUT}s after {FAIL_LIMIT} failed sign-ins")


def clear_failures(client):
    with _lock:
        _fails.pop(client, None)


