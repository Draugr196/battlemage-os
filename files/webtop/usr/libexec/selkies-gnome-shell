#!/usr/bin/env bash
# gnome-shell, plus a virtual monitor when this is a headless session.
# Size: SELKIES_VIRTUAL_MONITOR in /etc/selkies/local.env (WxH or WxH@R).
args=("$@")

# The value from the last file that sets it; parsed, not sourced
monitor_spec() {
  local v
  v="$(grep -hs '^SELKIES_VIRTUAL_MONITOR=' /usr/share/selkies/defaults.env /etc/selkies/local.env \
       | tail -n1 | cut -d= -f2- | tr -d "\"' ")"
  [[ "$v" =~ ^[0-9]+x[0-9]+(@[0-9]+(\.[0-9]+)?)?$ ]] || v="1920x1080@60"
  printf '%s' "$v"
}

# Headless = this user's graphical session has no seat
is_headless() {
  local ids s
  if [[ -n "${XDG_SESSION_ID:-}" ]]; then
    ids="$XDG_SESSION_ID"
  else
    ids="$(loginctl show-user "$(id -u)" -p Sessions --value 2>/dev/null)"
  fi
  [[ -z "$ids" ]] && return 1   # can't tell: leave gnome-shell alone
  for s in $ids; do
    [[ "$(loginctl show-session "$s" -p Type --value 2>/dev/null)" == wayland ]] || continue
    [[ -n "$(loginctl show-session "$s" -p Seat --value 2>/dev/null)" ]] && return 1
  done
  return 0
}

if is_headless; then
  args+=(--virtual-monitor "$(monitor_spec)")
fi

exec /usr/bin/gnome-shell "${args[@]}"
